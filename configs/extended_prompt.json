{
  "_说明": "实验配置。冻结后（校准开始前）不得修改；任何修改都要记录在 docs 中。价格与服务商路由在每次付费运行前到服务商页面核对。",
  "prompt_variant": "extended",
  "schema_style": "legacy",
  "model": {
    "model": "meta-llama/llama-3.1-8b-instruct",
    "api_base": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "temperature": 0.2,
    "top_p": 1.0,
    "max_tokens": 2048,
    "timeout": 120,
    "extra_body": {"provider": {"order": ["DeepInfra"], "allow_fallbacks": false}}
  },
  "price_usd_per_mtok": {"input": 0.02, "output": 0.04},
  "mysql": {
    "docker": true,
    "image": "mysql:8.0.36",
    "host": "127.0.0.1",
    "base_port": 13306,
    "user": "root",
    "password": null
  },
  "agent": {"max_rounds": 3, "first_action_only": true, "statement_timeout_ms": 10000},
  "run": {"workers": 4, "seed": 20261022, "budget_usd": 5.0},
  "prism": {
    "step_pp": 0.5,
    "min_exposed_groups": 10,
    "risk_table": "results/risk/risk_table.json",
    "risk_table_single_only": "results/risk/risk_table_single_only.json",
    "epsilons_pp": [1, 2, 4, 8, 16]
  },
  "baselines": {
    "random_k": 3,
    "static_epsilon_pp": 4,
    "llmlingua2": {
      "rate": 0.7,
      "model_name": "microsoft/llmlingua-2-xlm-roberta-large-meetingbank",
      "revision": "ebaba9b0e874dadd3003ffcff828e4397e568089",
      "device": "cpu"
    }
  },
  "_memory说明": "经验记忆库。store 由 build-memory 生成（只用构建集与开发集上 nomem 条件的运行，测试集不进入）；k_examples 为每次检索的相似示例条数（条件后加 #k=N 可覆盖），k_insights 为洞见条数，k_repairs 为修复经验条数；insights 为离线提炼洞见的设置。",
  "memory": {
    "enabled": true,
    "store": "results/memory/memory_store.json",
    "k_examples": 3,
    "k_insights": 3,
    "k_repairs": 2,
    "bm25": {"k1": 1.2, "b": 0.75},
    "max_answer_chars": 300,
    "insights": {"batch_size": 4, "max_rules": 3, "budget_usd": 0.5}
  },
  "stats": {"delta_pp": 5.0, "bootstrap": 10000, "seed": 20261022},
  "_reps说明": "各阶段每个条件每题的预定重复次数，冻结前确定。键为条件名；以 * 结尾的键按前缀匹配（取最长前缀）；* 匹配其余条件。",
  "reps": {
    "memory_build": {"nomem": 2},
    "risk_estimate": {"full": 3, "ablate:*": 2},
    "calibrate": {"*": 10},
    "compare": {"*": 10},
    "k_sensitivity": {"*": 3}
  },
  "complementary_pairs": [["answer_query", "empty_scalar"], ["one_stmt", "scope"], ["exp_top1", "insight"]]
}
